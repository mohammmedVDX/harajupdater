// ==UserScript==
// @name         Haraj Plus - حراج بلس
// @namespace    http://tampermonkey.net/
// @version      7.1.0
// @description  Haraj auto-updater and toolkit with native Haraj theme - تحديث إعلانات حراج بلس
// @author       Haraj Plus
// @match        *://haraj.com.sa/*
// @match        *://*.haraj.com.sa/*
// @match        *://haraj.com/*
// @match        *://*.haraj.com/*
// @include      *://haraj.com.sa/*
// @include      *://*.haraj.com.sa/*
// @include      *://haraj.com/*
// @include      *://*.haraj.com/*
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        GM_addStyle
// @grant        GM_xmlhttpRequest
// @run-at       document-end
// ==/UserScript==

(function() {
    'use strict';
    const VERSION = '7.1.0';
    console.log(`[Haraj Plus] Script initializing v${VERSION}...`);

    // OpenRouter API Configuration
    const OPENROUTER_CONFIG = {
        apiKey: atob('c2stb3ItdjEtZThlOGNjZjMyOTYxMGRiYjA4ODMxYzExYmU5YWY2ZThmMWFiN2UyYzgyN2IzYjc2YzQ5MzhiYmE4MTY5NGVjOA=='),
        apiUrl: 'https://openrouter.ai/api/v1/chat/completions',
        model: 'google/gemma-4-31b-it:free'
    };

    const CONFIG = {
        updateInterval: localStorage.getItem('updateInterval') ? parseInt(localStorage.getItem('updateInterval')) : 1000,
        adsPerBatch: localStorage.getItem('adsPerBatch') ? parseInt(localStorage.getItem('adsPerBatch')) : 6,
        token: null,
        clientId: null,
        graphqlEndpoint: 'https://graphql.haraj.com.sa/'
    };

    let isRunning = false;
    let currentIndex = 0;
    let postIds = [];
    let stats = { total: 0, updated: 0, failed: 0 };
    let tokenExpiredCount = 0;

    // Detect language from Haraj (dynamic check)
    function isArabicLanguage() {
        // Direct inspect of bottom nav "home" text
        const homeEl = document.querySelector('a[data-testid="home"]');
        if (homeEl) {
            const txt = (homeEl.textContent || '').trim();
            if (txt.includes('Home')) return false;
            if (txt.includes('الرئيسية')) return true;
        }

        if (window.location.pathname.startsWith('/en') || window.location.pathname.includes('/en/')) {
            return false;
        }

        const docLang = (document.documentElement.lang || '').toLowerCase();
        if (docLang.startsWith('en')) {
            return false;
        }

        try {
            const stored = localStorage.getItem('i18nextLng') || localStorage.getItem('lang');
            if (stored && stored.toLowerCase().startsWith('en')) {
                return false;
            }
        } catch (e) {}

        return true;
    }

    function getI18n() {
        const isAr = isArabicLanguage();
        return {
            isAr,
            plus: isAr ? 'بلس' : 'Plus',
            title: isAr ? 'حراج بلس' : 'Haraj Plus',
            update: isAr ? 'تحديث' : 'Update',
            updating: isAr ? 'جاري التحديث...' : 'Updating...',
            stop: isAr ? 'إيقاف' : 'Stop',
            myAds: isAr ? 'اعلاناتي' : 'My Ads',
            batch: isAr ? 'دفعة' : 'Batch',
            total: isAr ? 'إجمالي' : 'Total',
            updated: isAr ? 'محدث' : 'Updated',
            failed: isAr ? 'فشل' : 'Failed',
            remaining: isAr ? 'متبقي' : 'Remaining',
            logTitle: isAr ? 'سجل العمليات واستجابة السيرفر' : 'Debug Log & Server Response',
            sessionWarning: isAr ? '⚠️ انتهت الجلسة - مشكلة من السيرفر' : '⚠️ Session Expired',
            relogin: isAr ? '🔄 إعادة تسجيل الدخول' : '🔄 Login Again',
            ready: isAr ? `🚀 حراج بلس جاهز (v${VERSION})` : `🚀 Haraj Plus ready (v${VERSION})`,
            noAds: isAr ? 'لم يتم العثور على إعلانات في الصفحة' : 'No ads found on this page',
            loadedAds: isAr ? 'تم تحميل %s إعلان' : 'Loaded %s ads',
            done: isAr ? '✅ اكتمل التحديث بنجاح!' : '✅ Update completed successfully!',
            stopped: isAr ? '⏹️ تم إيقاف التحديث' : '⏹️ Update stopped'
        };
    }

    // Safe storage and style helpers (prevents ReferenceErrors if running without GM grants)
    function safeAddStyle(css) {
        if (typeof GM_addStyle === 'function') {
            GM_addStyle(css);
        } else {
            const style = document.createElement('style');
            style.textContent = css;
            (document.head || document.documentElement).appendChild(style);
        }
    }
    function safeGetValue(key, defaultVal) {
        try {
            if (typeof GM_getValue === 'function') return GM_getValue(key, defaultVal);
        } catch(e) {}
        const val = localStorage.getItem(key);
        return val !== null ? val : defaultVal;
    }
    function safeSetValue(key, val) {
        try {
            if (typeof GM_setValue === 'function') GM_setValue(key, val);
        } catch(e) {}
        try {
            localStorage.setItem(key, val);
        } catch(e) {}
    }

    // Inject styles
    safeAddStyle(`
        /* Desktop Fallback Floating Trigger Button (only when bottom nav is not in DOM) */
        #haraj-plus-desktop-btn {
            position: fixed !important;
            bottom: 24px !important;
            right: 24px !important;
            width: 48px !important;
            height: 48px !important;
            border-radius: 50% !important;
            background: #0066cc !important;
            color: #ffffff !important;
            display: none;
            align-items: center !important;
            justify-content: center !important;
            box-shadow: 0 4px 14px rgba(0, 102, 204, 0.4) !important;
            cursor: pointer !important;
            z-index: 999990 !important;
            border: 2px solid #ffffff !important;
            transition: transform 0.2s ease, box-shadow 0.2s ease !important;
        }
        #haraj-plus-desktop-btn:hover {
            transform: scale(1.05) !important;
            box-shadow: 0 6px 20px rgba(0, 102, 204, 0.5) !important;
        }

        /* Bottom Nav Item active state */
        #haraj-plus-nav-btn.active {
            color: #0066cc !important;
        }
        #haraj-plus-nav-btn.active svg {
            stroke: #0066cc !important;
        }

        /* Haraj Plus Popup Modal - Clean Haraj Theme (Blue, White, Black/Dark) */
        #haraj-plus-modal {
            position: fixed !important;
            bottom: 68px !important;
            left: 50% !important;
            transform: translateX(-50%) translateY(12px) scale(0.96) !important;
            width: calc(100% - 24px) !important;
            max-width: 350px !important;
            background: #ffffff !important;
            color: #0f172a !important;
            border-radius: 16px !important;
            box-shadow: 0 12px 35px -4px rgba(0, 0, 0, 0.2), 0 0 0 1px rgba(0, 0, 0, 0.08) !important;
            z-index: 9999999 !important;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Tajawal", sans-serif !important;
            opacity: 0 !important;
            pointer-events: none !important;
            transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.22s cubic-bezier(0.16, 1, 0.3, 1) !important;
            overflow: hidden !important;
            -webkit-user-select: none !important;
            user-select: none !important;
        }
        #haraj-plus-modal.show {
            opacity: 1 !important;
            pointer-events: auto !important;
            transform: translateX(-50%) translateY(0) scale(1) !important;
        }

        /* Haraj Dark Mode Support */
        html.dark #haraj-plus-modal,
        body.dark #haraj-plus-modal {
            background: #18191a !important;
            color: #f8fafc !important;
            box-shadow: 0 12px 35px -4px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.12) !important;
        }

        /* Modal Header */
        .haraj-modal-header {
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            padding: 12px 16px 10px 16px !important;
            border-bottom: 1px solid #f1f5f9 !important;
        }
        html.dark .haraj-modal-header {
            border-bottom-color: #262626 !important;
        }
        .haraj-modal-title {
            display: flex !important;
            align-items: center !important;
            gap: 8px !important;
            font-size: 14px !important;
            font-weight: 700 !important;
            color: #0066cc !important;
        }
        .haraj-plus-badge {
            background: rgba(0, 102, 204, 0.1) !important;
            color: #0066cc !important;
            font-size: 10px !important;
            padding: 2px 6px !important;
            border-radius: 6px !important;
            font-weight: 600 !important;
        }
        .haraj-modal-close {
            background: transparent !important;
            border: none !important;
            font-size: 20px !important;
            line-height: 1 !important;
            color: #94a3b8 !important;
            cursor: pointer !important;
            padding: 4px !important;
            border-radius: 6px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }
        .haraj-modal-close:hover {
            color: #0f172a !important;
            background: #f1f5f9 !important;
        }
        html.dark .haraj-modal-close:hover {
            color: #f8fafc !important;
            background: #2a2a2a !important;
        }

        /* Modal Body */
        .haraj-modal-body {
            padding: 14px 16px !important;
        }

        /* Action Buttons Grid: تحديث & اعلاناتي */
        .haraj-action-grid {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            gap: 10px !important;
            margin-bottom: 12px !important;
        }
        .haraj-btn-primary {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 6px !important;
            padding: 12px 10px !important;
            background: #0066cc !important;
            color: #ffffff !important;
            border: none !important;
            border-radius: 10px !important;
            font-size: 13px !important;
            font-weight: 700 !important;
            cursor: pointer !important;
            box-shadow: 0 3px 10px rgba(0, 102, 204, 0.25) !important;
            transition: all 0.18s ease !important;
            -webkit-tap-highlight-color: transparent !important;
        }
        .haraj-btn-primary:active {
            transform: scale(0.96) !important;
        }
        .haraj-btn-primary.is-running {
            background: #ef4444 !important;
            box-shadow: 0 3px 10px rgba(239, 68, 68, 0.3) !important;
        }
        .haraj-btn-primary:disabled {
            opacity: 0.6 !important;
            cursor: not-allowed !important;
        }

        .haraj-btn-secondary {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 6px !important;
            padding: 12px 10px !important;
            background: #f8fafc !important;
            color: #1e293b !important;
            border: 1px solid #e2e8f0 !important;
            border-radius: 10px !important;
            font-size: 13px !important;
            font-weight: 700 !important;
            cursor: pointer !important;
            transition: all 0.18s ease !important;
            -webkit-tap-highlight-color: transparent !important;
        }
        html.dark .haraj-btn-secondary {
            background: #242526 !important;
            color: #f1f5f9 !important;
            border-color: #383838 !important;
        }
        .haraj-btn-secondary:active {
            transform: scale(0.96) !important;
            background: #e2e8f0 !important;
        }
        html.dark .haraj-btn-secondary:active {
            background: #333333 !important;
        }

        /* Batch Speed Selector */
        .haraj-batch-row {
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            background: #f1f5f9 !important;
            border-radius: 8px !important;
            padding: 3px !important;
            margin-bottom: 12px !important;
        }
        html.dark .haraj-batch-row {
            background: #242526 !important;
        }
        .haraj-batch-btn {
            flex: 1 !important;
            padding: 5px 0 !important;
            border: none !important;
            background: transparent !important;
            color: #64748b !important;
            border-radius: 6px !important;
            font-size: 10px !important;
            font-weight: 600 !important;
            cursor: pointer !important;
            transition: all 0.15s ease !important;
            text-align: center !important;
        }
        .haraj-batch-btn.active {
            background: #ffffff !important;
            color: #0066cc !important;
            font-weight: 700 !important;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08) !important;
        }
        html.dark .haraj-batch-btn.active {
            background: #333333 !important;
            color: #38bdf8 !important;
        }

        /* Stats Row */
        .haraj-stats-grid {
            display: grid !important;
            grid-template-columns: repeat(4, 1fr) !important;
            gap: 6px !important;
            margin-bottom: 10px !important;
        }
        .haraj-stat-card {
            background: #f8fafc !important;
            border: 1px solid #f1f5f9 !important;
            border-radius: 8px !important;
            padding: 6px 2px !important;
            text-align: center !important;
        }
        html.dark .haraj-stat-card {
            background: #242526 !important;
            border-color: #303030 !important;
        }
        .haraj-stat-val {
            font-size: 14px !important;
            font-weight: 800 !important;
            color: #0066cc !important;
            display: block !important;
            line-height: 1.2 !important;
        }
        .haraj-stat-lbl {
            font-size: 9px !important;
            color: #64748b !important;
            font-weight: 600 !important;
        }

        /* Progress Bar */
        .haraj-progress-track {
            width: 100% !important;
            height: 4px !important;
            background: #e2e8f0 !important;
            border-radius: 2px !important;
            overflow: hidden !important;
            margin-bottom: 12px !important;
        }
        html.dark .haraj-progress-track {
            background: #333333 !important;
        }
        .haraj-progress-fill {
            height: 100% !important;
            width: 0% !important;
            background: #0066cc !important;
            transition: width 0.3s ease !important;
        }

        /* Token Warning & Relogin Button */
        .haraj-token-warning {
            display: none;
            background: #fef2f2 !important;
            border: 1px solid #fecaca !important;
            color: #dc2626 !important;
            font-size: 11px !important;
            font-weight: 600 !important;
            padding: 8px 10px !important;
            border-radius: 8px !important;
            margin-bottom: 10px !important;
            text-align: center !important;
        }
        .haraj-token-warning.show {
            display: block !important;
        }
        .haraj-relogin-btn {
            display: none;
            width: 100% !important;
            padding: 8px !important;
            background: #ef4444 !important;
            color: #ffffff !important;
            border: none !important;
            border-radius: 8px !important;
            font-size: 11px !important;
            font-weight: 700 !important;
            cursor: pointer !important;
            margin-bottom: 10px !important;
            text-align: center !important;
        }
        .haraj-relogin-btn.show {
            display: block !important;
        }

        /* Expandable Debug Log Accordion */
        .haraj-log-accordion {
            border: 1px solid #e2e8f0 !important;
            border-radius: 10px !important;
            overflow: hidden !important;
            background: #ffffff !important;
        }
        html.dark .haraj-log-accordion {
            border-color: #333333 !important;
            background: #18191a !important;
        }
        .haraj-log-toggle {
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            padding: 8px 12px !important;
            background: #f8fafc !important;
            cursor: pointer !important;
            user-select: none !important;
            transition: background 0.15s ease !important;
        }
        html.dark .haraj-log-toggle {
            background: #242526 !important;
        }
        .haraj-log-toggle:hover {
            background: #f1f5f9 !important;
        }
        html.dark .haraj-log-toggle:hover {
            background: #2a2a2a !important;
        }
        .haraj-log-toggle-left {
            display: flex !important;
            align-items: center !important;
            gap: 6px !important;
            font-size: 11px !important;
            font-weight: 600 !important;
            color: #475569 !important;
        }
        html.dark .haraj-log-toggle-left {
            color: #cbd5e1 !important;
        }
        .haraj-log-arrow {
            display: inline-block !important;
            font-size: 9px !important;
            transition: transform 0.2s ease !important;
            color: #0066cc !important;
        }
        .haraj-log-arrow.expanded {
            transform: rotate(90deg) !important;
        }
        .haraj-log-count-pill {
            background: #e2e8f0 !important;
            color: #475569 !important;
            font-size: 9px !important;
            font-weight: 700 !important;
            padding: 1px 6px !important;
            border-radius: 10px !important;
        }
        html.dark .haraj-log-count-pill {
            background: #383838 !important;
            color: #94a3b8 !important;
        }
        .haraj-log-collapse-body {
            max-height: 0 !important;
            overflow: hidden !important;
            opacity: 0 !important;
            transition: max-height 0.25s ease, opacity 0.2s ease !important;
        }
        .haraj-log-collapse-body.expanded {
            max-height: 140px !important;
            opacity: 1 !important;
            overflow-y: auto !important;
            border-top: 1px solid #e2e8f0 !important;
        }
        html.dark .haraj-log-collapse-body.expanded {
            border-top-color: #333333 !important;
        }
        .haraj-log-console {
            padding: 8px !important;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
            font-size: 9px !important;
            line-height: 1.4 !important;
            background: #fafafa !important;
        }
        html.dark .haraj-log-console {
            background: #121212 !important;
        }
        .haraj-log-item {
            padding: 3px 6px !important;
            margin-bottom: 3px !important;
            border-radius: 4px !important;
            border-right: 2px solid transparent !important;
            word-break: break-all !important;
        }
        .haraj-log-item.success {
            background: #f0fdf4 !important;
            color: #166534 !important;
            border-right-color: #22c55e !important;
        }
        html.dark .haraj-log-item.success {
            background: rgba(34, 197, 94, 0.15) !important;
            color: #86efac !important;
        }
        .haraj-log-item.error {
            background: #fef2f2 !important;
            color: #991b1b !important;
            border-right-color: #ef4444 !important;
        }
        html.dark .haraj-log-item.error {
            background: rgba(239, 68, 68, 0.15) !important;
            color: #fca5a5 !important;
        }
        .haraj-log-item.info {
            background: #f0f9ff !important;
            color: #075985 !important;
            border-right-color: #0284c7 !important;
        }
        html.dark .haraj-log-item.info {
            background: rgba(2, 132, 199, 0.15) !important;
            color: #7dd3fc !important;
        }
        .haraj-log-time {
            opacity: 0.65 !important;
            margin-left: 4px !important;
            font-size: 8px !important;
        }

        /* AI Helper Floating button & panel (Ad description refinement) */
        .haraj-ai-helper-btn {
            position: fixed !important;
            bottom: 75px !important;
            left: 16px !important;
            width: 42px !important;
            height: 42px !important;
            background: #0066cc !important;
            color: #ffffff !important;
            border-radius: 50% !important;
            box-shadow: 0 4px 14px rgba(0, 102, 204, 0.35) !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            font-size: 18px !important;
            cursor: pointer !important;
            z-index: 999992 !important;
            border: 2px solid #ffffff !important;
        }
        #haraj-ai-chat-panel {
            position: fixed !important;
            bottom: 70px !important;
            left: 16px !important;
            width: calc(100vw - 32px) !important;
            max-width: 340px !important;
            max-height: 65vh !important;
            background: #ffffff !important;
            border-radius: 14px !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25) !important;
            z-index: 999996 !important;
            display: none;
            flex-direction: column !important;
            border: 1px solid #e2e8f0 !important;
            font-family: inherit !important;
            color: #0f172a !important;
            direction: rtl !important;
            overflow: hidden !important;
        }
        html.dark #haraj-ai-chat-panel {
            background: #18191a !important;
            color: #f8fafc !important;
            border-color: #333333 !important;
        }
        #haraj-ai-chat-panel.show {
            display: flex !important;
        }
        .haraj-ai-header {
            background: #0066cc !important;
            color: #ffffff !important;
            padding: 8px 12px !important;
            display: flex !important;
            justify-content: space-between !important;
            align-items: center !important;
            font-size: 12px !important;
            font-weight: 700 !important;
        }
        .haraj-ai-messages {
            flex: 1 !important;
            overflow-y: auto !important;
            padding: 10px !important;
            font-size: 11px !important;
        }
        .haraj-ai-msg {
            margin-bottom: 6px !important;
            padding: 6px 8px !important;
            border-radius: 6px !important;
            line-height: 1.4 !important;
        }
        .haraj-ai-msg.user { background: #f1f5f9 !important; color: #1e293b !important; }
        html.dark .haraj-ai-msg.user { background: #262626 !important; color: #f8fafc !important; }
        .haraj-ai-msg.assistant { background: rgba(0, 102, 204, 0.1) !important; color: #0066cc !important; }
        .haraj-ai-preview-box {
            background: #fafafa !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 6px !important;
            padding: 6px !important;
            margin: 6px 0 !important;
            font-size: 10px !important;
            white-space: pre-wrap !important;
            max-height: 100px !important;
            overflow-y: auto !important;
        }
        html.dark .haraj-ai-preview-box { background: #121212 !important; border-color: #383838 !important; }
        .haraj-ai-actions { display: flex !important; gap: 6px !important; margin-top: 4px !important; }
        .haraj-ai-act-btn {
            flex: 1 !important; padding: 5px !important; border-radius: 4px !important;
            border: none !important; font-size: 10px !important; font-weight: 700 !important; cursor: pointer !important;
        }
        .haraj-ai-act-btn.accept { background: #16a34a !important; color: #fff !important; }
        .haraj-ai-act-btn.decline { background: #ef4444 !important; color: #fff !important; }
        .haraj-ai-input-wrap { display: flex !important; gap: 4px !important; padding: 6px !important; border-top: 1px solid #e2e8f0 !important; }
        html.dark .haraj-ai-input-wrap { border-top-color: #333333 !important; }
        .haraj-ai-input {
            flex: 1 !important; padding: 6px 8px !important; border-radius: 6px !important;
            border: 1px solid #cbd5e1 !important; font-size: 11px !important; outline: none !important;
        }
        html.dark .haraj-ai-input { background: #262626 !important; border-color: #404040 !important; color: #fff !important; }
        .haraj-ai-send {
            padding: 6px 12px !important; background: #0066cc !important; color: #fff !important;
            border: none !important; border-radius: 6px !important; cursor: pointer !important; font-weight: 700 !important;
        }
    `);

    // Create the Popup Modal (Starts hidden!)
    function createModal() {
        if (document.getElementById('haraj-plus-modal')) return;

        const i18n = getI18n();
        const modal = document.createElement('div');
        modal.id = 'haraj-plus-modal';
        modal.dir = i18n.isAr ? 'rtl' : 'ltr';

        modal.innerHTML = `
            <div class="haraj-modal-header">
                <div class="haraj-modal-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="16"></line>
                        <line x1="8" y1="12" x2="16" y2="12"></line>
                    </svg>
                    <span id="modal-title-text">${i18n.title}</span>
                    <span class="haraj-plus-badge">v${VERSION}</span>
                </div>
                <button class="haraj-modal-close" id="haraj-modal-close" title="Close">×</button>
            </div>
            <div class="haraj-modal-body">
                <div class="haraj-token-warning" id="token-warning">${i18n.sessionWarning}</div>
                <button class="haraj-relogin-btn" id="relogin-btn">${i18n.relogin}</button>

                <!-- 2 Main Actions: تحديث & اعلاناتي -->
                <div class="haraj-action-grid">
                    <button class="haraj-btn-primary" id="update-btn">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="23 4 23 10 17 10"></polyline>
                            <polyline points="1 20 1 14 7 14"></polyline>
                            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                        </svg>
                        <span id="update-btn-text">${i18n.update}</span>
                    </button>
                    <button class="haraj-btn-secondary" id="myads-btn">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        <span id="myads-btn-text">${i18n.myAds}</span>
                    </button>
                </div>

                <!-- Batch Speed Toggle -->
                <div class="haraj-batch-row">
                    <button class="haraj-batch-btn ${CONFIG.adsPerBatch === 3 ? 'active' : ''}" data-speed="3">3 ${i18n.batch}</button>
                    <button class="haraj-batch-btn ${CONFIG.adsPerBatch === 6 ? 'active' : ''}" data-speed="6">6 ${i18n.batch}</button>
                    <button class="haraj-batch-btn ${CONFIG.adsPerBatch === 12 ? 'active' : ''}" data-speed="12">12 ${i18n.batch}</button>
                </div>

                <!-- Live Statistics -->
                <div class="haraj-stats-grid">
                    <div class="haraj-stat-card">
                        <span class="haraj-stat-val" id="stat-total">0</span>
                        <span class="haraj-stat-lbl">${i18n.total}</span>
                    </div>
                    <div class="haraj-stat-card">
                        <span class="haraj-stat-val" id="stat-updated" style="color:#16a34a !important;">0</span>
                        <span class="haraj-stat-lbl">${i18n.updated}</span>
                    </div>
                    <div class="haraj-stat-card">
                        <span class="haraj-stat-val" id="stat-failed" style="color:#dc2626 !important;">0</span>
                        <span class="haraj-stat-lbl">${i18n.failed}</span>
                    </div>
                    <div class="haraj-stat-card">
                        <span class="haraj-stat-val" id="stat-remaining" style="color:#64748b !important;">0</span>
                        <span class="haraj-stat-lbl">${i18n.remaining}</span>
                    </div>
                </div>

                <!-- Progress Bar -->
                <div class="haraj-progress-track">
                    <div class="haraj-progress-fill" id="progress"></div>
                </div>

                <!-- Collapsible Debug Log with Arrow -->
                <div class="haraj-log-accordion">
                    <div class="haraj-log-toggle" id="haraj-log-toggle">
                        <div class="haraj-log-toggle-left">
                            <span class="haraj-log-arrow" id="haraj-log-arrow">▶</span>
                            <span>${i18n.logTitle}</span>
                        </div>
                        <span class="haraj-log-count-pill" id="haraj-log-count">0</span>
                    </div>
                    <div class="haraj-log-collapse-body" id="haraj-log-body">
                        <div class="haraj-log-console" id="log"></div>
                    </div>
                </div>
            </div>
        `;
        document.body.appendChild(modal);

        // Bind events inside modal
        document.getElementById('haraj-modal-close').onclick = () => toggleModal(false);
        document.getElementById('update-btn').onclick = handleUpdateClick;
        document.getElementById('myads-btn').onclick = openMyAds;
        document.getElementById('relogin-btn').onclick = () => window.location.href = 'https://haraj.com.sa/login';

        // Speed buttons
        modal.querySelectorAll('.haraj-batch-btn').forEach(btn => {
            btn.onclick = () => {
                const speed = parseInt(btn.getAttribute('data-speed'));
                CONFIG.adsPerBatch = speed;
                safeSetValue('adsPerBatch', speed);
                modal.querySelectorAll('.haraj-batch-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                addLog('info', `⚡ ${i18n.batch}: ${speed}`);
            };
        });

        // Debug Log Accordion Toggle
        const logToggle = document.getElementById('haraj-log-toggle');
        const logArrow = document.getElementById('haraj-log-arrow');
        const logBody = document.getElementById('haraj-log-body');

        logToggle.onclick = () => {
            const isExpanded = logBody.classList.contains('expanded');
            if (isExpanded) {
                logBody.classList.remove('expanded');
                logArrow.classList.remove('expanded');
            } else {
                logBody.classList.add('expanded');
                logArrow.classList.add('expanded');
            }
        };

        // Close when clicking outside modal
        document.addEventListener('click', (e) => {
            const navBtn = document.getElementById('haraj-plus-nav-btn');
            const desktopBtn = document.getElementById('haraj-plus-desktop-btn');
            if (!modal.contains(e.target) && (!navBtn || !navBtn.contains(e.target)) && (!desktopBtn || !desktopBtn.contains(e.target))) {
                if (modal.classList.contains('show')) {
                    toggleModal(false);
                }
            }
        });

        addLog('info', i18n.ready);
        console.log('[Haraj Plus] Modal initialized.');
    }

    // Toggle Modal visibility
    function toggleModal(forceState) {
        const modal = document.getElementById('haraj-plus-modal');
        const navBtn = document.getElementById('haraj-plus-nav-btn');
        if (!modal) return;

        const isCurrentlyShown = modal.classList.contains('show');
        const shouldShow = (typeof forceState === 'boolean') ? forceState : !isCurrentlyShown;

        if (shouldShow) {
            modal.classList.add('show');
            if (navBtn) navBtn.classList.add('active');
        } else {
            modal.classList.remove('show');
            if (navBtn) navBtn.classList.remove('active');
        }
    }

    // Safe locator for Haraj's bottom navigation bar
    function findBottomNav() {
        // Method 1: Check known children in the bottom bar
        const testIds = ['msgs', 'notes', 'new_post', 'all_sections', 'home'];
        for (const testId of testIds) {
            const el = document.querySelector(`a[data-testid="${testId}"]`);
            if (el && el.parentElement) {
                return el.parentElement;
            }
        }

        // Method 2: Check fixed bottom container
        const fixedDivs = document.querySelectorAll('div.fixed.bottom-0');
        for (const div of fixedDivs) {
            if (div.querySelector('a[href="/"], a[href*="post"], a[href*="note"], a[href*="chat"]')) {
                return div;
            }
        }

        return null;
    }

    // Inject the Plus / بلس button into the bottom navigation bar
    function injectNavButton() {
        const bottomNav = findBottomNav();
        const desktopBtn = document.getElementById('haraj-plus-desktop-btn');

        if (bottomNav) {
            if (desktopBtn) desktopBtn.style.display = 'none';

            const existingBtn = document.getElementById('haraj-plus-nav-btn');
            // If button is already properly placed inside bottomNav, just ensure label is fresh
            if (existingBtn && bottomNav.contains(existingBtn)) {
                const label = existingBtn.querySelector('.haraj-plus-label');
                if (label) {
                    const i18n = getI18n();
                    label.textContent = i18n.plus;
                }
                return;
            }

            // If it was attached somewhere else (or disconnected by React re-render), remove old instance
            if (existingBtn) {
                existingBtn.remove();
            }

            const i18n = getI18n();

            // Create button with Haraj's exact Tailwind classes
            const plusItem = document.createElement('a');
            plusItem.id = 'haraj-plus-nav-btn';
            plusItem.className = 'mt-1 grid flex-1 justify-center justify-items-center gap-0.5 text-elementary cursor-pointer select-none';
            plusItem.setAttribute('role', 'button');
            plusItem.setAttribute('tabindex', '0');
            plusItem.setAttribute('data-testid', 'haraj_plus');
            plusItem.setAttribute('data-discover', 'true');
            plusItem.style.transform = 'translate3d(0px, 0px, 0px)';
            plusItem.style.cursor = 'pointer';

            plusItem.innerHTML = `
                <span class="relative flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none"></circle>
                        <line x1="12" y1="8" x2="12" y2="16"></line>
                        <line x1="8" y1="12" x2="16" y2="12"></line>
                    </svg>
                </span>
                <div class="text-center haraj-plus-label">${i18n.plus}</div>
            `;

            plusItem.onclick = (e) => {
                e.preventDefault();
                e.stopPropagation();
                toggleModal();
            };

            // Place as the last item in the bottom nav bar
            bottomNav.appendChild(plusItem);
            console.log('[Haraj Plus] Injected "بلس" / "Plus" button into bottom navigation bar successfully!');
        } else {
            // Desktop fallback trigger
            let trigger = document.getElementById('haraj-plus-desktop-btn');
            if (!trigger) {
                trigger = document.createElement('div');
                trigger.id = 'haraj-plus-desktop-btn';
                trigger.innerHTML = `
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                `;
                trigger.title = 'Haraj Plus';
                trigger.onclick = (e) => {
                    e.stopPropagation();
                    toggleModal();
                };
                document.body.appendChild(trigger);
            }
            trigger.style.display = 'flex';
        }
    }

    // Token & Auth extraction
    function getAuthState() {
        const candidateKeys = ['login', 'statlogin', 'auth'];
        for (const key of candidateKeys) {
            try {
                const raw = localStorage.getItem(key);
                if (!raw) continue;
                const parsed = JSON.parse(raw);
                if (parsed?.state?.accessToken || parsed?.state?.username) {
                    return parsed.state;
                }
            } catch (e) {}
        }
        return null;
    }

    function extractToken() {
        const i18n = getI18n();
        const authState = getAuthState();
        if (authState?.accessToken) {
            const parts = authState.accessToken.split('.');
            if (parts.length === 3) {
                CONFIG.token = authState.accessToken;
                addLog('success', i18n.isAr ? '✓ تم استخراج التوكن من الجلسة' : '✓ Extracted token from session');
            }
        }

        try {
            const meta = localStorage.getItem('meta');
            if (meta) {
                const parsed = JSON.parse(meta);
                if (parsed.state?.clientId) {
                    CONFIG.clientId = parsed.state.clientId;
                }
            }
        } catch (e) {}

        if (!CONFIG.clientId) {
            CONFIG.clientId = '0hxR2sjN-VMMr-QtoI-Sydi-xHqrb6O2M0T8v3';
        }

        if (!CONFIG.token) {
            const cookieString = document.cookie;
            const accessTokenMatch = cookieString.match(/accessToken=([^;]+)/);
            if (accessTokenMatch) {
                const token = decodeURIComponent(accessTokenMatch[1]);
                const parts = token.split('.');
                if (parts.length === 3) {
                    CONFIG.token = token;
                    addLog('success', i18n.isAr ? '✓ تم استخراج التوكن من الكوكيز' : '✓ Extracted token from cookies');
                }
            }
        }

        if (!CONFIG.token) {
            addLog('error', i18n.isAr ? '✗ فشل استخراج التوكن - يرجى تسجيل الدخول' : '✗ Failed to extract token - please log in');
            return false;
        }

        return true;
    }

    function getMyUsername() {
        const authState = getAuthState();
        return authState?.username || null;
    }

    function openMyAds() {
        const i18n = getI18n();
        const username = getMyUsername();
        if (username) {
            addLog('info', `${i18n.isAr ? 'فتح إعلاناتي' : 'Opening ads'}: ${username}`);
            window.location.href = `https://haraj.com.sa/users/${username}`;
        } else {
            addLog('error', i18n.isAr ? 'لم يتم العثور على اسم المستخدم - سجل الدخول أولاً' : 'Username not found - please log in first');
        }
    }

    // Load posts from page
    async function loadPosts() {
        const i18n = getI18n();
        addLog('info', i18n.isAr ? 'جاري فحص الإعلانات في الصفحة...' : 'Scanning ads on page...');
        const updateBtn = document.getElementById('update-btn');
        if (updateBtn) updateBtn.disabled = true;

        let previousCount = 0;
        for (let i = 0; i < 50; i++) {
            window.scrollTo(0, document.body.scrollHeight);
            await sleep(900);
            const loadMoreBtn = document.querySelector('[data-testid="posts-load-more"]');
            if (loadMoreBtn && !loadMoreBtn.disabled) loadMoreBtn.click();
            const currentCount = document.querySelectorAll('[data-test-postid]').length;
            if (currentCount === previousCount) break;
            previousCount = currentCount;
        }

        window.scrollTo(0, 0);
        collectPosts();
        if (updateBtn) updateBtn.disabled = false;
    }

    function collectPosts() {
        const i18n = getI18n();
        postIds = [];
        document.querySelectorAll('[data-test-postid]').forEach(el => {
            const id = el.getAttribute('data-test-postid');
            if (id) postIds.push(parseInt(id));
        });

        stats = { total: postIds.length, updated: 0, failed: 0 };
        currentIndex = 0;
        updateStats();

        if (postIds.length > 0) {
            addLog('success', i18n.loadedAds.replace('%s', postIds.length));
        } else {
            addLog('error', i18n.noAds);
        }
    }

    function handleUpdateClick() {
        if (isRunning) {
            stopUpdating();
        } else {
            loadAndUpdate();
        }
    }

    async function loadAndUpdate() {
        await loadPosts();
        if (postIds.length > 0) {
            await startUpdating();
        }
    }

    async function startUpdating() {
        if (!extractToken()) {
            return;
        }

        const i18n = getI18n();
        hideTokenWarning();
        isRunning = true;

        const updateBtn = document.getElementById('update-btn');
        const updateBtnText = document.getElementById('update-btn-text');
        if (updateBtn) updateBtn.classList.add('is-running');
        if (updateBtnText) updateBtnText.textContent = i18n.stop;

        addLog('info', i18n.isAr ? 'بدء التحديث المجدول...' : 'Starting batch update...');
        await updateBatch();
    }

    async function updateBatch() {
        const i18n = getI18n();
        if (!isRunning || currentIndex >= postIds.length) {
            if (currentIndex >= postIds.length) {
                addLog('success', i18n.done);
                stopUpdating();
            }
            return;
        }

        const batch = postIds.slice(currentIndex, currentIndex + CONFIG.adsPerBatch);
        for (let id of batch) {
            if (!isRunning) break;
            await updatePost(id);
        }

        currentIndex += CONFIG.adsPerBatch;
        updateStats();

        if (isRunning && currentIndex < postIds.length) {
            setTimeout(() => updateBatch(), CONFIG.updateInterval);
        } else if (currentIndex >= postIds.length) {
            addLog('success', i18n.done);
            stopUpdating();
        }
    }

    async function updatePost(id) {
        try {
            const lang = document.documentElement.lang || 'ar';
            const url = `${CONFIG.graphqlEndpoint}?queryName=updatePost&lang=${lang}&clientId=${CONFIG.clientId}&version=N0.0.1`;

            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': '*/*',
                    'Origin': 'https://haraj.com.sa',
                    'Referer': 'https://haraj.com.sa/'
                },
                credentials: 'include',
                body: JSON.stringify({
                    query: `mutation updatePost($token: String!, $id: Int!) {\n updatePost(token: $token, id: $id) {\n status\n notValidReason\n }\n}`,
                    variables: { token: CONFIG.token, id: id }
                })
            });

            const data = await response.json();

            if (data.data?.updatePost?.status === true) {
                stats.updated++;
                addLog('success', `✓ #${id} (Status: 200 OK)`);
                tokenExpiredCount = 0;
            } else {
                stats.failed++;
                const reason = data.data?.updatePost?.notValidReason || (data.errors ? data.errors[0]?.message : 'Error');

                if (reason === 'لم يتم تسجيل الدخول') {
                    tokenExpiredCount++;
                    addLog('error', `✗ #${id}: جلسة منتهية (${tokenExpiredCount}/3)`);
                    if (tokenExpiredCount >= 3) {
                        addLog('error', '🛑 استجابة السيرفر: الجلسة منتهية، يرجى تسجيل الدخول مجدداً');
                        showTokenWarning();
                        stopUpdating();
                    }
                } else {
                    addLog('error', `✗ #${id}: ${reason} [Server: ${JSON.stringify(data.data?.updatePost || data.errors || {})}]`);
                }
            }
        } catch (error) {
            stats.failed++;
            addLog('error', `✗ #${id}: خطأ اتصال (${error.message})`);
        }
    }

    function stopUpdating() {
        const i18n = getI18n();
        isRunning = false;
        const updateBtn = document.getElementById('update-btn');
        const updateBtnText = document.getElementById('update-btn-text');
        if (updateBtn) updateBtn.classList.remove('is-running');
        if (updateBtnText) updateBtnText.textContent = i18n.update;
    }

    function showTokenWarning() {
        const warn = document.getElementById('token-warning');
        const relogin = document.getElementById('relogin-btn');
        if (warn) warn.classList.add('show');
        if (relogin) relogin.classList.add('show');
    }

    function hideTokenWarning() {
        const warn = document.getElementById('token-warning');
        const relogin = document.getElementById('relogin-btn');
        if (warn) warn.classList.remove('show');
        if (relogin) relogin.classList.remove('show');
        tokenExpiredCount = 0;
    }

    function updateStats() {
        const setTxt = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
        setTxt('stat-total', stats.total);
        setTxt('stat-updated', stats.updated);
        setTxt('stat-failed', stats.failed);
        setTxt('stat-remaining', Math.max(0, stats.total - currentIndex));

        const progress = stats.total > 0 ? (currentIndex / stats.total) * 100 : 0;
        const progEl = document.getElementById('progress');
        if (progEl) progEl.style.width = Math.min(100, progress) + '%';
    }

    function addLog(type, msg) {
        const i18n = getI18n();
        const log = document.getElementById('log');
        const countPill = document.getElementById('haraj-log-count');
        if (!log) return;

        const entry = document.createElement('div');
        entry.className = `haraj-log-item ${type}`;
        const time = new Date().toLocaleTimeString(i18n.isAr ? 'ar-SA' : 'en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        entry.innerHTML = `<span class="haraj-log-time">${time}</span> ${msg}`;
        log.insertBefore(entry, log.firstChild);

        while (log.children.length > 80) log.removeChild(log.lastChild);
        if (countPill) countPill.textContent = log.children.length;
    }

    function sleep(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    // ========== AI HELPER (Ad Description Enhancement) ==========
    let aiChatMessages = [];
    let currentTextarea = null;
    let suggestedText = '';

    function injectAIButton() {
        const textarea = document.querySelector('textarea[data-testid="add-post-bodyText"]');
        if (!textarea || document.getElementById('haraj-ai-helper-btn')) return;

        const i18n = getI18n();
        const aiBtn = document.createElement('div');
        aiBtn.id = 'haraj-ai-helper-btn';
        aiBtn.className = 'haraj-ai-helper-btn';
        aiBtn.innerHTML = '🤖';
        aiBtn.title = i18n.isAr ? 'مساعد الذكاء الاصطناعي لكتابة الإعلان' : 'AI Assistant';

        const chatPanel = createAIChatPanel();
        document.body.appendChild(aiBtn);
        document.body.appendChild(chatPanel);

        aiBtn.addEventListener('click', () => {
            currentTextarea = textarea;
            chatPanel.classList.toggle('show');
            if (chatPanel.classList.contains('show')) {
                addAIMessage('system', i18n.isAr ? 'مرحباً! أستطيع مساعدتك في تحسين نص إعلانك وتنسيقه باحترافية. اكتب المطلوب وسأقوم بصياغته.' : 'Hello! I can help refine and optimize your ad copy. What would you like to improve?');
            }
        });
    }

    function createAIChatPanel() {
        const i18n = getI18n();
        const panel = document.createElement('div');
        panel.id = 'haraj-ai-chat-panel';
        panel.innerHTML = `
            <div class="haraj-ai-header">
                <span>🤖 ${i18n.isAr ? 'مساعد إعلانات حراج' : 'Haraj AI Assistant'}</span>
                <button style="background:none;border:none;color:#fff;font-size:18px;cursor:pointer;" class="haraj-ai-close">×</button>
            </div>
            <div class="haraj-ai-messages" id="haraj-ai-messages"></div>
            <div class="haraj-ai-input-wrap">
                <input type="text" class="haraj-ai-input" id="haraj-ai-input" placeholder="${i18n.isAr ? 'اكتب طلبك هنا...' : 'Type your request...'}" />
                <button class="haraj-ai-send" id="haraj-ai-send-btn">➤</button>
            </div>
        `;

        panel.querySelector('.haraj-ai-close').onclick = () => panel.classList.remove('show');
        const input = panel.querySelector('#haraj-ai-input');
        const sendBtn = panel.querySelector('#haraj-ai-send-btn');

        sendBtn.onclick = () => sendAIMessage(input);
        input.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendAIMessage(input);
        });

        return panel;
    }

    function addAIMessage(role, content, showPreview = false) {
        const container = document.getElementById('haraj-ai-messages');
        if (!container) return;

        const i18n = getI18n();
        const msgDiv = document.createElement('div');
        msgDiv.className = `haraj-ai-msg ${role}`;

        if (showPreview && role === 'assistant') {
            msgDiv.innerHTML = `
                <div>${content}</div>
                <div class="haraj-ai-preview-box">${suggestedText}</div>
                <div class="haraj-ai-actions">
                    <button class="haraj-ai-act-btn accept" id="ai-accept">${i18n.isAr ? '✓ تطبيق على الإعلان' : '✓ Apply'}</button>
                    <button class="haraj-ai-act-btn decline" id="ai-decline">${i18n.isAr ? '✗ إلغاء' : '✗ Cancel'}</button>
                </div>
            `;
            msgDiv.querySelector('#ai-accept').onclick = acceptAIText;
            msgDiv.querySelector('#ai-decline').onclick = declineAIText;
        } else {
            msgDiv.textContent = content;
        }

        container.appendChild(msgDiv);
        container.scrollTop = container.scrollHeight;
    }

    async function sendAIMessage(input) {
        const message = input.value.trim();
        if (!message || !currentTextarea) return;

        const i18n = getI18n();
        const sendBtn = document.getElementById('haraj-ai-send-btn');
        if (sendBtn) sendBtn.disabled = true;

        addAIMessage('user', message);
        aiChatMessages.push({ role: 'user', content: message });
        input.value = '';

        addAIMessage('system', i18n.isAr ? 'جاري التحسين والرد...' : 'Thinking...');

        try {
            const currentContent = currentTextarea.value;
            const systemPrompt = `أنت مساعد خبير متخصص في تحسين إعلانات منصة حراج السعودية. النص الحالي للإعلان هو:\n"${currentContent}"\nقم بصياغة أو تعديل النص ليصبح جذاباً وواضحاً ومناسباً لمنصة حراج بدون مقدمات أو شرح إضافي.`;

            const messages = [
                { role: 'system', content: systemPrompt },
                ...aiChatMessages
            ];

            const response = await fetch(OPENROUTER_CONFIG.apiUrl, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${OPENROUTER_CONFIG.apiKey}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    model: OPENROUTER_CONFIG.model,
                    messages: messages
                })
            });

            const data = await response.json();
            const container = document.getElementById('haraj-ai-messages');
            if (container && container.lastChild && container.lastChild.classList.contains('system')) {
                container.removeChild(container.lastChild);
            }

            if (data.choices && data.choices[0]) {
                const aiResponse = data.choices[0].message.content;
                suggestedText = aiResponse;
                aiChatMessages.push({ role: 'assistant', content: aiResponse });
                addAIMessage('assistant', i18n.isAr ? 'إليك النص المقترح للإعلان:' : 'Here is the refined text:', true);
            } else {
                addAIMessage('system', i18n.isAr ? 'حدث خطأ في معالجة الطلب.' : 'Error processing request.');
            }
        } catch (e) {
            addAIMessage('system', i18n.isAr ? 'تعذر الاتصال بالذكاء الاصطناعي.' : 'Failed to connect to AI.');
        } finally {
            if (sendBtn) sendBtn.disabled = false;
        }
    }

    function acceptAIText() {
        const i18n = getI18n();
        if (currentTextarea && suggestedText) {
            currentTextarea.value = suggestedText;
            currentTextarea.dispatchEvent(new Event('input', { bubbles: true }));
            currentTextarea.dispatchEvent(new Event('change', { bubbles: true }));
            addAIMessage('system', i18n.isAr ? '✓ تم تحديث نص الإعلان بنجاح!' : '✓ Updated ad text!');
            suggestedText = '';
        }
    }

    function declineAIText() {
        const i18n = getI18n();
        addAIMessage('system', i18n.isAr ? 'تم إلغاء الاقتراح.' : 'Cancelled.');
        suggestedText = '';
    }

    // Main Init
    function tick() {
        try {
            createModal();
            injectNavButton();
            injectAIButton();
        } catch (err) {
            console.error('[Haraj Plus] Tick error:', err);
        }
    }

    function init() {
        tick();

        // 1. Polling interval to handle React hydration / delayed rendering
        let attempts = 0;
        const intervalId = setInterval(() => {
            tick();
            attempts++;
            if (attempts >= 40) { // Poll for 12 seconds
                clearInterval(intervalId);
            }
        }, 300);

        // 2. MutationObserver for SPA route changes and dynamic updates
        try {
            const observer = new MutationObserver(() => {
                tick();
            });

            observer.observe(document.body || document.documentElement, {
                childList: true,
                subtree: true
            });
        } catch (e) {
            console.error('[Haraj Plus] Observer setup error:', e);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
