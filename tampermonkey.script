// ==UserScript==
// @name         Haraj Auto Updater - محدث حراج التلقائي
// @namespace    http://tampermonkey.net/
// @version      6.5.0
// @description  Auto update Haraj ads - تحديث إعلانات حراج تلقائياً
// @author       You
// @match        https://haraj.com.sa/*
// @match        https://www.haraj.com.sa/*
// @match        https://haraj.com/*
// @match        https://www.haraj.com/*
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        GM_addStyle
// @grant        GM_xmlhttpRequest
// @run-at       document-end
// ==/UserScript==

(function() {
    'use strict';

    const VERSION = '6.5.0';
    
    // OpenRouter API Configuration (obfuscated key, no specific @connect needed)
    const OPENROUTER_CONFIG = {
        apiKey: atob('c2stb3ItdjEtZThlOGNjZjMyOTYxMGRiYjA4ODMxYzExYmU5YWY2ZThmMWFiN2UyYzgyN2IzYjc2YzQ5MzhiYmE4MTY5NGVjOA=='),
        apiUrl: 'https://openrouter.ai/api/v1/chat/completions',
        model: 'google/gemma-4-31b-it:free'
    };
    
    const CONFIG = {
        updateInterval: GM_getValue('updateInterval', 1000),
        adsPerBatch: GM_getValue('adsPerBatch', 6),
        token: null,
        clientId: null,
        graphqlEndpoint: 'https://graphql.haraj.com.sa/'
    };

    let isRunning = false;
    let currentIndex = 0;
    let postIds = [];
    let stats = { total: 0, updated: 0, failed: 0 };
    let tokenExpiredCount = 0;

    // Presets State Management
    let presets = JSON.parse(localStorage.getItem('haraj_presets') || '[]');
    let currentEditIndex = -1;
    let tempImages = [];

    const LOCATIONS = {
        riyadh: { lat: 24.7135517, lon: 46.6752957, name: "الرياض" },
        jeddah: { lat: 21.492083616072, lon: 39.364103710848, name: "جدة" }
    };

    GM_addStyle(`
        #haraj-menu {
            position: fixed; top: 20px; right: 20px; width: 340px;
            background: linear-gradient(145deg, #667eea 0%, #764ba2 100%);
            border-radius: 12px; box-shadow: 0 15px 50px rgba(0,0,0,0.5); z-index: 999999;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: white;
            direction: rtl; border: 3px solid rgba(255,255,255,0.15);
        }
        #haraj-header {
            background: rgba(0,0,0,0.3); padding: 16px; cursor: move;
            display: flex; justify-content: space-between; align-items: center;
            border-radius: 10px 10px 0 0; border-bottom: 2px solid rgba(255,255,255,0.1);
        }
        #haraj-header h3 {
            margin: 0; font-size: 18px; font-weight: 700; letter-spacing: 0.5px;
            display: flex; align-items: center; gap: 10px;
        }
        .version-badge {
            font-size: 10px; background: rgba(16,185,129,0.3); padding: 3px 8px;
            border-radius: 12px; font-weight: 600; border: 1px solid rgba(16,185,129,0.5);
        }
        #haraj-minimize {
            background: rgba(255,255,255,0.2); border: none; color: white;
            width: 30px; height: 30px; border-radius: 6px; cursor: pointer;
            font-size: 20px; font-weight: bold; transition: all 0.3s;
        }
        #haraj-minimize:hover { background: rgba(255,255,255,0.3); transform: rotate(90deg); }
        #haraj-content { padding: 18px; }
        .speed-control {
            display: flex; gap: 8px; margin-bottom: 14px;
            background: rgba(0,0,0,0.25); padding: 10px; border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.15);
        }
        .speed-btn {
            flex: 1; padding: 10px; border: 2px solid rgba(255,255,255,0.25);
            border-radius: 6px; background: rgba(255,255,255,0.12); color: white;
            font-size: 12px; font-weight: 700; cursor: pointer; transition: all 0.3s;
        }
        .speed-btn:hover {
            background: rgba(255,255,255,0.25); border-color: rgba(255,255,255,0.5);
            transform: translateY(-2px);
        }
        .speed-btn.active {
            background: rgba(16,185,129,0.5); border-color: #10b981;
            box-shadow: 0 0 15px rgba(16,185,129,0.4);
        }
        .btn-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
        .btn-grid-full { display: grid; grid-template-columns: 1fr; gap: 10px; margin-bottom: 14px; }
        .haraj-btn {
            padding: 13px; border: none; border-radius: 8px; font-size: 13px;
            font-weight: 700; cursor: pointer; transition: all 0.3s;
            box-shadow: 0 3px 10px rgba(0,0,0,0.3);
        }
        .haraj-btn:disabled { opacity: 0.35; cursor: not-allowed; box-shadow: none; }
        .haraj-btn:hover:not(:disabled) {
            transform: translateY(-3px); box-shadow: 0 6px 15px rgba(0,0,0,0.4);
        }
        .btn-load { background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; }
        .btn-start { background: linear-gradient(135deg, #10b981, #059669); color: white; }
        .btn-like { background: linear-gradient(135deg, #f59e0b, #d97706); color: white; }
        .btn-stop { background: linear-gradient(135deg, #ef4444, #dc2626); color: white; }
        .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 14px 0; }
        .stat {
            background: rgba(255,255,255,0.15); padding: 12px; border-radius: 8px;
            text-align: center; font-size: 12px; border: 1px solid rgba(255,255,255,0.12);
        }
        .stat-value { font-size: 26px; font-weight: 800; display: block; margin-bottom: 3px; }
        .stat-label { font-size: 11px; opacity: 0.9; font-weight: 600; }
        .progress {
            width: 100%; height: 10px; background: rgba(0,0,0,0.35); border-radius: 5px;
            overflow: hidden; margin: 14px 0; border: 1px solid rgba(255,255,255,0.15);
        }
        .progress-bar {
            height: 100%; background: linear-gradient(90deg, #10b981, #34d399, #10b981);
            background-size: 200% 100%; transition: width 0.3s;
            box-shadow: 0 0 12px rgba(16,185,129,0.6); animation: shimmer 2s infinite;
        }
        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }
        .log {
            background: rgba(0,0,0,0.4); border-radius: 8px; padding: 12px;
            max-height: 200px; overflow-y: auto; font-size: 11px;
            border: 1px solid rgba(255,255,255,0.15); font-family: 'Courier New', monospace;
        }
        .log::-webkit-scrollbar { width: 8px; }
        .log::-webkit-scrollbar-track { background: rgba(0,0,0,0.3); border-radius: 4px; }
        .log::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.4); border-radius: 4px; }
        .log-entry {
            padding: 7px 10px; margin-bottom: 5px; border-radius: 5px;
            border-left: 4px solid transparent; line-height: 1.5;
        }
        .log-success { background: rgba(16,185,129,0.2); border-left-color: #10b981; }
        .log-error { background: rgba(239,68,68,0.2); border-left-color: #ef4444; }
        .log-info { background: rgba(59,130,246,0.2); border-left-color: #3b82f6; }
        .log-warning { background: rgba(245,158,11,0.2); border-left-color: #f59e0b; }
        .log-time { opacity: 0.7; font-size: 10px; margin-left: 8px; }
        .token-warning {
            background: rgba(239,68,68,0.25); border: 2px solid #ef4444; border-radius: 8px;
            padding: 12px; margin-bottom: 14px; text-align: center;
            font-size: 13px; font-weight: 700; display: none;
        }
        .token-warning.show { display: block; animation: pulse 2s infinite; }
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.02); }
        }
        .btn-relogin {
            background: linear-gradient(135deg, #ef4444, #dc2626); color: white;
            width: 100%; padding: 12px; border: none; border-radius: 8px;
            font-size: 14px; font-weight: 700; cursor: pointer; margin-bottom: 14px;
            display: none; box-shadow: 0 4px 12px rgba(239,68,68,0.4);
        }
        .btn-relogin.show { display: block; }
        .btn-relogin:hover {
            transform: translateY(-2px); box-shadow: 0 6px 16px rgba(239,68,68,0.5);
        }
        .minimized #haraj-content { display: none; }
        
        /* AI Chat Styles */
        .ai-helper-btn {
            position: absolute;
            bottom: 8px;
            left: 8px;
            width: 40px;
            height: 40px;
            background: linear-gradient(145deg, #10b981, #059669);
            border: 2px solid rgba(255,255,255,0.4);
            border-radius: 50%;
            box-shadow: 0 4px 12px rgba(16,185,129,0.4);
            cursor: pointer;
            z-index: 999997;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: white;
            transition: transform 0.2s ease;
        }
        .ai-helper-btn:hover {
            transform: scale(1.1);
        }
        
        #ai-chat-panel {
            position: fixed;
            bottom: 60px;
            left: 20px;
            width: 400px;
            max-height: 70vh;
            background: linear-gradient(145deg, #10b981 0%, #059669 100%);
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.6);
            z-index: 999998;
            display: none;
            flex-direction: column;
            border: 2px solid rgba(255,255,255,0.2);
            color: white;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        #ai-chat-panel.show {
            display: flex;
        }
        
        .ai-chat-header {
            background: rgba(0,0,0,0.3);
            padding: 12px 14px;
            border-radius: 10px 10px 0 0;
            border-bottom: 2px solid rgba(255,255,255,0.15);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .ai-chat-header h4 {
            margin: 0;
            font-size: 15px;
            font-weight: 700;
            color: white;
        }
        .ai-close-btn {
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            width: 28px;
            height: 28px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .ai-close-btn:hover {
            background: rgba(255,255,255,0.3);
        }
        
        .ai-chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 12px;
            direction: rtl;
        }
        .ai-chat-messages::-webkit-scrollbar { width: 8px; }
        .ai-chat-messages::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); }
        .ai-chat-messages::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.3); border-radius: 4px; }
        
        .ai-message {
            margin-bottom: 10px;
            padding: 10px 12px;
            border-radius: 8px;
            font-size: 13px;
            line-height: 1.4;
            word-wrap: break-word;
        }
        .ai-message.user {
            background: rgba(255,255,255,0.25);
            margin-left: 40px;
        }
        .ai-message.assistant {
            background: rgba(0,0,0,0.3);
            margin-right: 40px;
        }
        .ai-message.system {
            background: rgba(59,130,246,0.3);
            text-align: center;
            font-size: 12px;
            font-style: italic;
        }
        
        .ai-preview-box {
            background: rgba(0,0,0,0.4);
            border: 2px solid rgba(255,255,255,0.2);
            border-radius: 6px;
            padding: 10px;
            margin: 10px 0;
            max-height: 150px;
            overflow-y: auto;
            font-size: 12px;
            white-space: pre-wrap;
            direction: rtl;
        }
        
        .ai-action-btns {
            display: flex;
            gap: 8px;
            margin-top: 8px;
        }
        .ai-action-btn {
            flex: 1;
            padding: 8px;
            border: none;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            color: white;
            transition: transform 0.2s;
        }
        .ai-action-btn.accept {
            background: rgba(16,185,129,0.8);
        }
        .ai-action-btn.accept:hover {
            background: rgba(16,185,129,1);
            transform: translateY(-2px);
        }
        .ai-action-btn.decline {
            background: rgba(239,68,68,0.8);
        }
        .ai-action-btn.decline:hover {
            background: rgba(239,68,68,1);
            transform: translateY(-2px);
        }
        
        .ai-chat-input-area {
            padding: 10px;
            background: rgba(0,0,0,0.2);
            border-radius: 0 0 10px 10px;
        }
        .ai-input-wrapper {
            display: flex;
            gap: 8px;
        }
        .ai-chat-input {
            flex: 1;
            background: rgba(255,255,255,0.2);
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 6px;
            padding: 10px;
            color: white;
            font-size: 13px;
            outline: none;
            direction: rtl;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .ai-chat-input::placeholder {
            color: rgba(255,255,255,0.6);
        }
        .ai-send-btn {
            width: 45px;
            height: 45px;
            background: rgba(255,255,255,0.25);
            border: none;
            border-radius: 6px;
            color: white;
            font-size: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
        }
        .ai-send-btn:hover {
            background: rgba(255,255,255,0.4);
        }
        .ai-send-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }
    `);

    function createMenu() {
        const menu = document.createElement('div');
        menu.id = 'haraj-menu';
        menu.innerHTML = `
            <div id="haraj-header">
                <h3>🔄 محدث حراج <span class="version-badge">v${VERSION}</span></h3>
                <button id="haraj-minimize">−</button>
            </div>
            <div id="haraj-content">
                <!-- MAIN VIEW -->
                <div id="main-view">
                    <div class="token-warning" id="token-warning">⚠️ انتهت الجلسة - مشكلة من السيرفر</div>
                    <button class="btn-relogin" id="relogin-btn">🔄 إعادة تسجيل الدخول</button>
                    <div class="speed-control">
                        <button class="speed-btn" data-speed="3">3 دفعة</button>
                        <button class="speed-btn active" data-speed="6">6 دفعة</button>
                        <button class="speed-btn" data-speed="12">12 دفعة</button>
                    </div>
                    <div class="btn-grid">
                        <button class="haraj-btn btn-start" id="update-btn">▶️ تحديث</button>
                        <button class="haraj-btn btn-myads" id="myads-btn" style="background:linear-gradient(135deg, #8b5cf6, #7c3aed) !important; color:white !important;">📋 اعلاناتي</button>
                    </div>
                    <div class="btn-grid">
                        <button class="haraj-btn btn-like" id="like-btn" disabled>❤️ تفضيل</button>
                        <button class="haraj-btn btn-stop" id="stop-btn" disabled>⏸️ إيقاف</button>
                    </div>
                    <div class="btn-grid-full">
                        <button class="haraj-btn" id="presets-btn" style="width:100% !important; background:linear-gradient(135deg, #8b5cf6, #7c3aed) !important; color:white !important;">📋 قوالب النشر</button>
                    </div>
                    <div class="stats">
                        <div class="stat"><span class="stat-value" id="stat-total">0</span><span class="stat-label">إجمالي</span></div>
                        <div class="stat"><span class="stat-value" id="stat-updated">0</span><span class="stat-label">محدث</span></div>
                        <div class="stat"><span class="stat-value" id="stat-failed">0</span><span class="stat-label">فشل</span></div>
                        <div class="stat"><span class="stat-value" id="stat-remaining">0</span><span class="stat-label">متبقي</span></div>
                    </div>
                    <div class="progress"><div class="progress-bar" id="progress"></div></div>
                    <div class="log" id="log"></div>
                </div>

                <!-- PRESETS LIST VIEW -->
                <div id="presets-view" style="display: none;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                        <span style="font-weight:700; font-size:12px;">📋 القوالب المحفوظة</span>
                        <button class="haraj-btn btn-stop" id="btn-back-to-main" style="padding:4px 8px !important; font-size:10px !important;">رجوع</button>
                    </div>
                    <div id="presets-list" style="max-height:150px; overflow-y:auto; margin-bottom:8px; display:flex; flex-direction:column; gap:6px;"></div>
                    <button class="haraj-btn btn-start" id="btn-add-preset-form" style="width:100% !important; padding:8px !important; font-size:11px !important;">➕ إضافة قالب جديد</button>
                </div>

                <!-- PRESET FORM VIEW -->
                <div id="preset-form-view" style="display: none;">
                    <span id="form-title" style="font-weight:700; font-size:12px; display:block; margin-bottom:6px;">➕ قالب جديد</span>
                    <input type="text" id="preset-title" style="width:100% !important; margin-bottom:6px !important; padding:6px !important; background:rgba(255,255,255,0.15) !important; border:1px solid rgba(255,255,255,0.2) !important; color:white !important; border-radius:6px !important; font-size:11px !important;" placeholder="عنوان الإعلان" />
                    <textarea id="preset-desc" style="width:100% !important; height:60px !important; margin-bottom:6px !important; padding:6px !important; background:rgba(255,255,255,0.15) !important; border:1px solid rgba(255,255,255,0.2) !important; color:white !important; border-radius:6px !important; font-size:11px !important; resize:none;" placeholder="نص الإعلان (الوصف)"></textarea>
                    
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px; margin-bottom:6px;">
                        <input type="number" id="preset-price" style="width:100% !important; padding:6px !important; background:rgba(255,255,255,0.15) !important; border:1px solid rgba(255,255,255,0.2) !important; color:white !important; border-radius:6px !important; font-size:11px !important;" placeholder="السعر (اختياري)" />
                        <input type="text" id="preset-phone" style="width:100% !important; padding:6px !important; background:rgba(255,255,255,0.15) !important; border:1px solid rgba(255,255,255,0.2) !important; color:white !important; border-radius:6px !important; font-size:11px !important;" placeholder="رقم التواصل" value="966557507544" />
                    </div>

                    <select id="preset-location" style="width:100% !important; margin-bottom:6px !important; padding:6px !important; background:#764ba2 !important; border:1px solid rgba(255,255,255,0.2) !important; color:white !important; border-radius:6px !important; font-size:11px !important;">
                        <option value="jeddah">جدة</option>
                        <option value="riyadh">الرياض</option>
                    </select>

                    <div style="margin-bottom:8px; background:rgba(0,0,0,0.2); padding:6px; border-radius:6px;">
                        <label style="font-size:10px; display:block; margin-bottom:4px;">تحميل الصور:</label>
                        <input type="file" id="preset-image-uploader" multiple accept="image/*" style="font-size:10px; display:block; width:100%; margin-bottom:4px;" />
                        <div id="upload-status" style="font-size:10px; color:#10b981; margin-bottom:4px; font-weight:700;"></div>
                        <div id="preset-images-preview" style="display:flex; gap:6px; overflow-x:auto; padding:4px; max-height:45px;"></div>
                    </div>

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                        <button class="haraj-btn btn-start" id="btn-save-preset" style="padding:8px !important;">حفظ</button>
                        <button class="haraj-btn btn-stop" id="btn-cancel-preset" style="padding:8px !important;">إلغاء</button>
                    </div>
                </div>
            </div>
        `;
        document.body.appendChild(menu);
        
        makeDraggable(menu);
        
        document.getElementById('haraj-minimize').onclick = () => {
            menu.classList.toggle('minimized');
            document.getElementById('haraj-minimize').textContent = menu.classList.contains('minimized') ? '+' : '−';
        };
        
        document.getElementById('relogin-btn').onclick = () => window.location.href = 'https://haraj.com.sa/login';
        
        document.querySelectorAll('.speed-btn').forEach(btn => {
            btn.onclick = () => {
                const speed = parseInt(btn.getAttribute('data-speed'));
                CONFIG.adsPerBatch = speed;
                GM_setValue('adsPerBatch', speed);
                document.querySelectorAll('.speed-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                addLog('info', `⚡ السرعة: ${speed} لكل دفعة`);
            };
        });
        
        document.getElementById('update-btn').onclick = loadAndUpdate;
        document.getElementById('like-btn').onclick = likeAll;
        document.getElementById('stop-btn').onclick = stop;

        // Presets View Switchers
        document.getElementById('presets-btn').onclick = () => {
            renderPresets();
            switchView('presets');
        };
        document.getElementById('btn-back-to-main').onclick = () => switchView('main');
        document.getElementById('btn-add-preset-form').onclick = () => openPresetForm(-1);
        document.getElementById('btn-save-preset').onclick = savePreset;
        document.getElementById('btn-cancel-preset').onclick = () => switchView('presets');
        document.getElementById('preset-image-uploader').onchange = handleImageUpload;
        
        addLog('info', `🚀 محدث حراج v${VERSION} جاهز!`);
    }

    function switchView(viewName) {
        document.getElementById('main-view').style.display = viewName === 'main' ? 'block' : 'none';
        document.getElementById('presets-view').style.display = viewName === 'presets' ? 'block' : 'none';
        document.getElementById('preset-form-view').style.display = viewName === 'form' ? 'block' : 'none';
    }

    function renderPresets() {
        const listDiv = document.getElementById('presets-list');
        if (!listDiv) return;
        listDiv.innerHTML = '';
        if (presets.length === 0) {
            listDiv.innerHTML = '<div style="font-size:10px; text-align:center; padding:10px; opacity:0.8;">لا توجد قوالب محفوظة</div>';
            return;
        }
        
        presets.forEach((preset, index) => {
            const item = document.createElement('div');
            item.style.cssText = 'background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.15); border-radius:6px; padding:6px; display:flex; flex-direction:column; gap:4px; font-size:11px;';
            
            const header = document.createElement('div');
            header.style.cssText = 'display:flex; justify-content:space-between; align-items:center;';
            
            const titleSpan = document.createElement('span');
            titleSpan.style.cssText = 'font-weight:700; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:200px; cursor:pointer;';
            titleSpan.textContent = preset.title;
            titleSpan.onclick = () => {
                runPresetValidation(preset);
                switchView('main');
            };

            const actionsDiv = document.createElement('div');
            actionsDiv.style.cssText = 'display:flex; gap:4px;';

            const cloneBtn = document.createElement('button');
            cloneBtn.innerHTML = '📋';
            cloneBtn.title = 'نسخ';
            cloneBtn.style.cssText = 'background:rgba(255,255,255,0.2); border:none; border-radius:4px; color:white; font-size:10px; cursor:pointer; padding:3px;';
            cloneBtn.onclick = (e) => {
                e.stopPropagation();
                clonePreset(index);
            };

            const editBtn = document.createElement('button');
            editBtn.innerHTML = '✏️';
            editBtn.title = 'تعديل';
            editBtn.style.cssText = 'background:rgba(255,255,255,0.2); border:none; border-radius:4px; color:white; font-size:10px; cursor:pointer; padding:3px;';
            editBtn.onclick = (e) => {
                e.stopPropagation();
                openPresetForm(index);
            };

            const delBtn = document.createElement('button');
            delBtn.innerHTML = '🗑️';
            delBtn.title = 'حذف';
            delBtn.style.cssText = 'background:rgba(239,68,68,0.4); border:none; border-radius:4px; color:white; font-size:10px; cursor:pointer; padding:3px;';
            delBtn.onclick = (e) => {
                e.stopPropagation();
                deletePreset(index);
            };

            actionsDiv.appendChild(cloneBtn);
            actionsDiv.appendChild(editBtn);
            actionsDiv.appendChild(delBtn);
            header.appendChild(titleSpan);
            header.appendChild(actionsDiv);
            item.appendChild(header);

            const details = document.createElement('div');
            details.style.cssText = 'display:flex; justify-content:space-between; font-size:9px; opacity:0.8;';
            const locName = LOCATIONS[preset.location]?.name || preset.location;
            const priceText = preset.price ? `${preset.price} ريال` : 'بدون سعر';
            const imgCount = preset.images ? preset.images.length : 0;
            details.innerHTML = `<span>📍 ${locName} | 💰 ${priceText}</span> <span>🖼️ ${imgCount} صور</span>`;
            item.appendChild(details);
            
            listDiv.appendChild(item);
        });
    }

    function openPresetForm(index = -1) {
        currentEditIndex = index;
        const formTitle = document.getElementById('form-title');
        const titleInput = document.getElementById('preset-title');
        const descInput = document.getElementById('preset-desc');
        const priceInput = document.getElementById('preset-price');
        const phoneInput = document.getElementById('preset-phone');
        const locSelect = document.getElementById('preset-location');
        const statusDiv = document.getElementById('upload-status');
        
        statusDiv.textContent = '';
        document.getElementById('preset-image-uploader').value = '';

        if (index >= 0) {
            formTitle.textContent = '✏️ تعديل قالب';
            const p = presets[index];
            titleInput.value = p.title || '';
            descInput.value = p.description || '';
            priceInput.value = p.price || '';
            phoneInput.value = p.phone || '966557507544';
            locSelect.value = p.location || 'jeddah';
            tempImages = [...(p.images || [])];
        } else {
            formTitle.textContent = '➕ قالب جديد';
            titleInput.value = '';
            descInput.value = '';
            priceInput.value = '';
            phoneInput.value = '966557507544';
            locSelect.value = 'jeddah';
            tempImages = [];
        }
        renderImagesPreview();
        switchView('form');
    }

    function renderImagesPreview() {
        const container = document.getElementById('preset-images-preview');
        if (!container) return;
        container.innerHTML = '';
        tempImages.forEach((img, idx) => {
            const wrapper = document.createElement('div');
            wrapper.style.cssText = 'position:relative; width:36px; height:36px; flex-shrink:0;';
            
            const thumb = document.createElement('img');
            thumb.src = img;
            thumb.style.cssText = 'width:100%; height:100%; object-fit:cover; border-radius:4px; border:1px solid rgba(255,255,255,0.3);';
            
            const removeBtn = document.createElement('div');
            removeBtn.innerHTML = '×';
            removeBtn.style.cssText = 'position:absolute; top:-2px; right:-2px; background:red; color:white; border-radius:50%; width:12px; height:12px; display:flex; align-items:center; justify-content:center; font-size:8px; cursor:pointer; font-weight:bold;';
            removeBtn.onclick = () => {
                tempImages.splice(idx, 1);
                renderImagesPreview();
            };
            
            wrapper.appendChild(thumb);
            wrapper.appendChild(removeBtn);
            container.appendChild(wrapper);
        });
    }

    async function handleImageUpload(e) {
        const files = e.target.files;
        if (!files.length) return;
        
        const statusDiv = document.getElementById('upload-status');
        statusDiv.textContent = 'جاري الرفع...';
        
        let successCount = 0;
        let failCount = 0;
        
        for (let file of files) {
            try {
                const imageUrl = await uploadToHaraj(file);
                if (imageUrl) {
                    tempImages.push(imageUrl);
                    successCount++;
                } else {
                    failCount++;
                }
            } catch (err) {
                console.error('Image upload failed:', err);
                failCount++;
            }
            renderImagesPreview();
        }
        
        if (failCount > 0) {
            statusDiv.textContent = `تم رفع ${successCount} صور بنجاح، وفشل ${failCount}`;
            statusDiv.style.color = '#ef4444';
        } else {
            statusDiv.textContent = `تم الرفع بنجاح! (${successCount} صور)`;
            statusDiv.style.color = '#10b981';
        }
    }

    async function uploadToHaraj(file) {
        const formData = new FormData();
        formData.append('file', file);

        const response = await fetch('https://k1mctje3wh.execute-api.eu-west-1.amazonaws.com/release/upload', {
            method: 'POST',
            body: formData,
            headers: {
                'Accept': '*/*',
                'Origin': 'https://haraj.com.sa'
            }
        });

        if (!response.ok) {
            throw new Error(`Upload server error: ${response.status}`);
        }

        const data = await response.json();
        let rawPath = data.path || data.url || data.location || (data.data && (data.data.url || data.data.path)) || null;
        if (!rawPath) {
            if (typeof data === 'string') rawPath = data;
            else if (data.filename) rawPath = data.filename;
        }

        if (rawPath) {
            if (!rawPath.startsWith('http')) {
                const cleanPath = rawPath.startsWith('/') ? rawPath.substring(1) : rawPath;
                return `https://s3-eu-west-1.amazonaws.com/img4.haraj.com.sa/${cleanPath}`;
            }
            return rawPath;
        }
        
        throw new Error('Could not parse image URL');
    }

    function savePreset() {
        const title = document.getElementById('preset-title').value.trim();
        const description = document.getElementById('preset-desc').value.trim();
        const price = document.getElementById('preset-price').value.trim();
        const phone = document.getElementById('preset-phone').value.trim();
        const location = document.getElementById('preset-location').value;

        if (!title) {
            alert('يرجى إدخال عنوان القالب');
            return;
        }

        const presetData = {
            title,
            description,
            price: price ? parseInt(price) : null,
            phone: phone || '966557507544',
            location,
            images: [...tempImages]
        };

        if (currentEditIndex >= 0) {
            presets[currentEditIndex] = presetData;
        } else {
            presets.push(presetData);
        }

        localStorage.setItem('haraj_presets', JSON.stringify(presets));
        renderPresets();
        switchView('presets');
    }

    function deletePreset(index) {
        if (confirm('هل أنت متأكد من حذف هذا القالب؟')) {
            presets.splice(index, 1);
            localStorage.setItem('haraj_presets', JSON.stringify(presets));
            renderPresets();
        }
    }

    function clonePreset(index) {
        const original = presets[index];
        const clone = {
            ...original,
            title: original.title + ' (نسخة)'
        };
        presets.push(clone);
        localStorage.setItem('haraj_presets', JSON.stringify(presets));
        renderPresets();
    }

    async function runPresetValidation(preset) {
        if (!extractToken()) {
            addLog('error', 'فشل استخراج التوكن - يرجى تسجيل الدخول');
            return;
        }

        addLog('info', `⏳ بدء التحقق من القالب: ${preset.title}...`);

        const lat = LOCATIONS[preset.location]?.lat || 21.492083616072;
        const lon = LOCATIONS[preset.location]?.lon || 39.364103710848;

        const lang = document.documentElement.lang || 'ar';
        const url = `${CONFIG.graphqlEndpoint}?queryName=validatePost&lang=${lang}&clientId=${CONFIG.clientId}&version=N0.0.1%20,%202026-08-11%2022/`;

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': '*/*',
                    'Origin': 'https://haraj.com.sa',
                    'Referer': 'https://haraj.com.sa/',
                    'Authorization': 'Bearer ' + CONFIG.token
                },
                credentials: 'include',
                body: JSON.stringify({
                    query: `query ValidatePostQuery($carExtraInfo: CarExtraInfo, $token: String!, $title: String!, $bodyTEXT: String!, $contact: String = null, $tags: [String] = null, $imagesList: [String] = null, $lat: Float!, $lon: Float!, $price: String = null, $locationInfoSource: locationInfoSource = null, $re_ExtraInfo: Re_ExtraInfo = null, $GeneralExtraInfo: [KeyValuePair] = null) {\n  validatePost(\n    CarExtraInfo: $carExtraInfo\n    token: $token\n    title: $title\n    bodyTEXT: $bodyTEXT\n    contact: $contact\n    tags: $tags\n    imagesList: $imagesList\n    lat: $lat\n    lon: $lon\n    price: $price\n    locationInfoSource: $locationInfoSource\n    re_ExtraInfo: $re_ExtraInfo\n    GeneralExtraInfo: $GeneralExtraInfo\n  ) {\n    status\n    notValidReason\n  }\n}`,
                    variables: {
                        token: CONFIG.token,
                        title: preset.title,
                        bodyTEXT: preset.description,
                        lat: lat,
                        lon: lon,
                        contact: preset.phone || "966557507544",
                        tags: ["كل الحراج", "اثاث", "طاولات وكراسي"],
                        imagesList: preset.images || [],
                        price: preset.price ? String(preset.price) : null,
                        carExtraInfo: null,
                        locationInfoSource: "API",
                        re_ExtraInfo: null,
                        GeneralExtraInfo: null
                    }
                })
            });

            const data = await response.json();
            
            if (data.data?.validatePost?.status === true) {
                addLog('success', `✓ ${preset.title}: تم التحقق بنجاح!`);
            } else {
                const reason = data.data?.validatePost?.notValidReason || 'فشل غير معروف';
                addLog('error', `✗ ${preset.title}: فشل التحقق (${reason})`);
            }
        } catch (error) {
            console.error('Validation request failed:', error);
            addLog('error', `✗ ${preset.title}: خطأ في شبكة الاتصال`);
        }
    }


    function makeDraggable(el) {
        const header = el.querySelector('#haraj-header');
        let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
        header.onmousedown = (e) => {
            e.preventDefault();
            pos3 = e.clientX;
            pos4 = e.clientY;
            document.onmouseup = () => { document.onmouseup = null; document.onmousemove = null; };
            document.onmousemove = (e) => {
                e.preventDefault();
                pos1 = pos3 - e.clientX;
                pos2 = pos4 - e.clientY;
                pos3 = e.clientX;
                pos4 = e.clientY;
                el.style.top = (el.offsetTop - pos2) + "px";
                el.style.right = "auto";
                el.style.left = (el.offsetLeft - pos1) + "px";
            };
        };
    }

    function extractToken() {
        const cookieString = document.cookie;
        
        // Extract CLIENT_ID from localStorage meta
        try {
            const meta = localStorage.getItem('meta');
            if (meta) {
                const parsed = JSON.parse(meta);
                if (parsed.state?.clientId) {
                    CONFIG.clientId = parsed.state.clientId;
                    addLog('info', `✓ CLIENT_ID: ${CONFIG.clientId.substring(0, 15)}...`);
                }
            }
        } catch (e) {
            console.error('Failed to extract clientId from meta:', e);
        }
        
        // Fallback to default if not found
        if (!CONFIG.clientId) {
            CONFIG.clientId = '0hxR2sjN-VMMr-QtoI-Sydi-xHqrb6O2M0T8v3';
            addLog('warning', '⚠ استخدام CLIENT_ID الافتراضي');
        }
        
        // Extract accessToken from cookies
        const accessTokenMatch = cookieString.match(/accessToken=([^;]+)/);
        if (accessTokenMatch) {
            const token = decodeURIComponent(accessTokenMatch[1]);
            const parts = token.split('.');
            if (parts.length === 3) {
                CONFIG.token = token;
                addLog('success', '✓ تم استخراج التوكن');
                return true;
            }
        }
        
        addLog('error', '✗ فشل استخراج التوكن');
        return false;
    }

    async function loadPosts() {
        addLog('info', 'جاري تحميل الإعلانات...');
        document.getElementById('update-btn').disabled = true;
        
        let previousCount = 0;
        for (let i = 0; i < 50; i++) {
            window.scrollTo(0, document.body.scrollHeight);
            await sleep(1000);
            const loadMoreBtn = document.querySelector('[data-testid="posts-load-more"]');
            if (loadMoreBtn && !loadMoreBtn.disabled) loadMoreBtn.click();
            const currentCount = document.querySelectorAll('[data-test-postid]').length;
            if (currentCount === previousCount) break;
            previousCount = currentCount;
        }
        
        window.scrollTo(0, 0);
        collectPosts();
        document.getElementById('update-btn').disabled = false;
    }
    
    async function loadAndUpdate() {
        await loadPosts();
        if (postIds.length > 0) {
            await startUpdating();
        }
    }

    function collectPosts() {
        postIds = [];
        document.querySelectorAll('[data-test-postid]').forEach(el => {
            const id = el.getAttribute('data-test-postid');
            if (id) postIds.push(parseInt(id));
        });
        
        stats = { total: postIds.length, updated: 0, failed: 0 };
        currentIndex = 0;
        updateStats();
        
        if (postIds.length > 0) {
            addLog('success', `تم تحميل ${postIds.length} إعلان`);
            document.getElementById('like-btn').disabled = false;
        } else {
            addLog('error', 'لم يتم العثور على إعلانات');
        }
    }

    async function startUpdating() {
        if (!extractToken()) {
            addLog('error', 'فشل استخراج التوكن');
            return;
        }
        
        hideTokenWarning();
        isRunning = true;
        document.getElementById('update-btn').disabled = true;
        document.getElementById('stop-btn').disabled = false;
        document.getElementById('like-btn').disabled = true;
        addLog('info', 'بدء التحديث...');
        await updateBatch();
    }

    async function updateBatch() {
        if (!isRunning || currentIndex >= postIds.length) {
            if (currentIndex >= postIds.length) {
                addLog('success', '✅ اكتمل التحديث!');
                stop();
            }
            return;
        }

        const batch = postIds.slice(currentIndex, currentIndex + CONFIG.adsPerBatch);
        for (let id of batch) {
            if (!isRunning) break;
            await updatePost(id);
        }

        currentIndex += CONFIG.adsPerBatch;
        updateStats();

        if (isRunning && currentIndex < postIds.length) {
            setTimeout(() => updateBatch(), CONFIG.updateInterval);
        } else if (currentIndex >= postIds.length) {
            addLog('success', '✅ اكتمل التحديث!');
            stop();
        }
    }

    async function updatePost(id) {
        try {
            const lang = document.documentElement.lang || 'ar';
            const url = `${CONFIG.graphqlEndpoint}?queryName=updatePost&lang=${lang}&clientId=${CONFIG.clientId}&version=N0.0.1`;
            
            const response = await fetch(url, {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': '*/*',
                    'Origin': 'https://haraj.com.sa',
                    'Referer': 'https://haraj.com.sa/'
                },
                credentials: 'include',
                body: JSON.stringify({
                    query: `mutation updatePost($token: String!, $id: Int!) {\n  updatePost(token: $token, id: $id) {\n    status\n    notValidReason\n  }\n}`,
                    variables: { token: CONFIG.token, id: id }
                })
            });

            const data = await response.json();
            
            if (data.data?.updatePost?.status === true) {
                stats.updated++;
                addLog('success', `✓ #${id}`);
                tokenExpiredCount = 0;
            } else {
                stats.failed++;
                const reason = data.data?.updatePost?.notValidReason || 'فشل';
                
                if (reason === 'لم يتم تسجيل الدخول') {
                    tokenExpiredCount++;
                    addLog('error', `✗ #${id}: جلسة منتهية (${tokenExpiredCount}/3)`);
                    if (tokenExpiredCount >= 3) {
                        addLog('error', '🛑 مشكلة سيرفر - الجلسة منتهية');
                        addLog('info', '💡 إعادة الدخول قد تحل المشكلة مؤقتاً');
                        showTokenWarning();
                        stop();
                    }
                } else {
                    addLog('error', `✗ #${id}: ${reason}`);
                }
            }
        } catch (error) {
            stats.failed++;
            addLog('error', `✗ #${id}`);
        }
    }
    
    function showTokenWarning() {
        document.getElementById('token-warning').classList.add('show');
        document.getElementById('relogin-btn').classList.add('show');
    }
    
    function hideTokenWarning() {
        document.getElementById('token-warning').classList.remove('show');
        document.getElementById('relogin-btn').classList.remove('show');
        tokenExpiredCount = 0;
    }

    async function likeAll() {
        if (!extractToken()) {
            addLog('error', 'فشل استخراج التوكن');
            return;
        }
        
        isRunning = true;
        document.getElementById('like-btn').disabled = true;
        document.getElementById('update-btn').disabled = true;
        document.getElementById('stop-btn').disabled = false;
        addLog('info', 'بدء التفضيل...');
        
        for (let i = 0; i < postIds.length; i++) {
            if (!isRunning) break;
            await likePost(postIds[i]);
            updateStats();
            await sleep(CONFIG.updateInterval);
        }
        
        addLog('success', '✅ اكتمل التفضيل!');
        stop();
    }

    async function likePost(id) {
        try {
            const response = await fetch(CONFIG.graphqlEndpoint + `?queryName=submitLike&clientId=${CONFIG.clientId}&version=N0.0.1`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({
                    query: `mutation { submitLike(token: "${CONFIG.token}", id: ${id}) }`,
                })
            });
            
            const data = await response.json();
            if (data.data?.submitLike) {
                stats.updated++;
                addLog('success', `❤️ #${id}`);
            }
        } catch (error) {
            stats.failed++;
        }
    }

    function stop() {
        isRunning = false;
        document.getElementById('update-btn').disabled = false;
        document.getElementById('stop-btn').disabled = true;
        document.getElementById('like-btn').disabled = false;
    }

    function updateStats() {
        document.getElementById('stat-total').textContent = stats.total;
        document.getElementById('stat-updated').textContent = stats.updated;
        document.getElementById('stat-failed').textContent = stats.failed;
        document.getElementById('stat-remaining').textContent = Math.max(0, stats.total - currentIndex);
        const progress = stats.total > 0 ? (currentIndex / stats.total) * 100 : 0;
        document.getElementById('progress').style.width = progress + '%';
    }

    function addLog(type, msg) {
        const log = document.getElementById('log');
        if (!log) return;
        const entry = document.createElement('div');
        entry.className = `log-entry log-${type}`;
        const time = new Date().toLocaleTimeString('ar-SA', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        entry.innerHTML = `<span class="log-time">${time}</span> ${msg}`;
        log.insertBefore(entry, log.firstChild);
        while (log.children.length > 100) log.removeChild(log.lastChild);
    }

    function sleep(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    // ========== AI HELPER FUNCTIONALITY ==========
    let aiChatMessages = [];
    let currentTextarea = null;
    let suggestedText = '';
    
    function injectAIButton() {
        const textarea = document.querySelector('textarea[data-testid="add-post-bodyText"]');
        if (!textarea || document.getElementById('ai-helper-btn')) return;
        
        // Make textarea container position relative
        const container = textarea.parentElement;
        if (container) {
            container.style.position = 'relative';
        }
        
        // Create AI button
        const aiBtn = document.createElement('div');
        aiBtn.id = 'ai-helper-btn';
        aiBtn.className = 'ai-helper-btn';
        aiBtn.innerHTML = '🤖';
        aiBtn.title = 'مساعد AI';
        
        // Create AI chat panel
        const chatPanel = createAIChatPanel();
        
        // Insert button and panel
        container.appendChild(aiBtn);
        document.body.appendChild(chatPanel);
        
        // Button click handler
        aiBtn.addEventListener('click', () => {
            currentTextarea = textarea;
            chatPanel.classList.toggle('show');
            if (chatPanel.classList.contains('show')) {
                addAIMessage('system', 'مرحباً! أنا هنا لمساعدتك في تحسين نص إعلانك. اكتب ما تريد تغييره أو تحسينه.');
            }
        });
    }
    
    function createAIChatPanel() {
        const panel = document.createElement('div');
        panel.id = 'ai-chat-panel';
        panel.innerHTML = `
            <div class="ai-chat-header">
                <h4>🤖 مساعد الذكاء الاصطناعي</h4>
                <button class="ai-close-btn">×</button>
            </div>
            <div class="ai-chat-messages" id="ai-messages"></div>
            <div class="ai-chat-input-area">
                <div class="ai-input-wrapper">
                    <input type="text" class="ai-chat-input" id="ai-input" placeholder="اكتب رسالتك هنا..." />
                    <button class="ai-send-btn" id="ai-send-btn">📤</button>
                </div>
            </div>
        `;
        
        // Close button handler
        panel.querySelector('.ai-close-btn').addEventListener('click', () => {
            panel.classList.remove('show');
        });
        
        // Send button handler
        const input = panel.querySelector('#ai-input');
        const sendBtn = panel.querySelector('#ai-send-btn');
        
        sendBtn.addEventListener('click', () => sendAIMessage(input));
        input.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendAIMessage(input);
        });
        
        return panel;
    }
    
    function addAIMessage(role, content, showPreview = false) {
        const messagesContainer = document.getElementById('ai-messages');
        if (!messagesContainer) return;
        
        const messageDiv = document.createElement('div');
        messageDiv.className = `ai-message ${role}`;
        
        if (showPreview && role === 'assistant') {
            const textNode = document.createElement('div');
            textNode.textContent = content;
            
            const previewBox = document.createElement('div');
            previewBox.className = 'ai-preview-box';
            previewBox.textContent = suggestedText;
            
            const actionBtns = document.createElement('div');
            actionBtns.className = 'ai-action-btns';
            
            const acceptBtn = document.createElement('button');
            acceptBtn.className = 'ai-action-btn accept';
            acceptBtn.textContent = '✓ قبول التغييرات';
            acceptBtn.addEventListener('click', acceptAIText);
            
            const declineBtn = document.createElement('button');
            declineBtn.className = 'ai-action-btn decline';
            declineBtn.textContent = '✗ رفض';
            declineBtn.addEventListener('click', declineAIText);
            
            actionBtns.appendChild(acceptBtn);
            actionBtns.appendChild(declineBtn);
            
            messageDiv.appendChild(textNode);
            messageDiv.appendChild(previewBox);
            messageDiv.appendChild(actionBtns);
        } else {
            messageDiv.textContent = content;
        }
        
        messagesContainer.appendChild(messageDiv);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }
    
    function sendAIMessage(input) {
        const message = input.value.trim();
        if (!message || !currentTextarea) return;
        
        const sendBtn = document.getElementById('ai-send-btn');
        sendBtn.disabled = true;
        
        // Add user message
        addAIMessage('user', message);
        aiChatMessages.push({ role: 'user', content: message });
        input.value = '';
        
        // Add loading message
        addAIMessage('system', 'جاري التفكير...');
        
        try {
            // Get current textarea content
            const currentContent = currentTextarea.value;
            
            // Build context for AI
            const systemPrompt = `أنت مساعد ذكي متخصص في تحسين إعلانات حراج. النص الحالي في الإعلان هو:\n"${currentContent}"\n\nساعد المستخدم في تحسين أو تعديل هذا النص حسب طلبه. قدم النص المحسّن كاملاً بدون شرح إضافي.`;
            
            const messages = [
                { role: 'system', content: systemPrompt },
                ...aiChatMessages
            ];
            
            // Call OpenRouter API using GM_xmlhttpRequest
            GM_xmlhttpRequest({
                method: 'POST',
                url: OPENROUTER_CONFIG.apiUrl,
                headers: {
                    'Authorization': `Bearer ${OPENROUTER_CONFIG.apiKey}`,
                    'Content-Type': 'application/json'
                },
                data: JSON.stringify({
                    model: OPENROUTER_CONFIG.model,
                    messages: messages
                }),
                onload: function(response) {
                    try {
                        const data = JSON.parse(response.responseText);
                        const messagesContainer = document.getElementById('ai-messages');
                        
                        if (messagesContainer && messagesContainer.lastChild && messagesContainer.lastChild.classList.contains('system')) {
                            messagesContainer.removeChild(messagesContainer.lastChild);
                        }
                        
                        if (response.status !== 200 || data.error) {
                            const errorMsg = data.error?.message || 'خطأ غير معروف';
                            console.error('API Error:', data);
                            addAIMessage('system', `❌ خطأ: ${errorMsg}`);
                            sendBtn.disabled = false;
                            return;
                        }
                        
                        const aiResponse = data.choices[0].message.content;
                        suggestedText = aiResponse;
                        aiChatMessages.push({ role: 'assistant', content: aiResponse });
                        addAIMessage('assistant', 'إليك النص المحسّن:', true);
                        sendBtn.disabled = false;
                    } catch (error) {
                        console.error('AI Parse Error:', error);
                        addAIMessage('system', 'عذراً، حدث خطأ في معالجة الرد.');
                        sendBtn.disabled = false;
                    }
                },
                onerror: function(error) {
                    console.error('AI Network Error:', error);
                    const messagesContainer = document.getElementById('ai-messages');
                    if (messagesContainer && messagesContainer.lastChild && messagesContainer.lastChild.classList.contains('system')) {
                        messagesContainer.removeChild(messagesContainer.lastChild);
                    }
                    addAIMessage('system', 'عذراً، حدث خطأ في الاتصال.');
                    sendBtn.disabled = false;
                }
            });
            
        } catch (error) {
            console.error('AI Error:', error);
            addAIMessage('system', 'عذراً، حدث خطأ غير متوقع. حاول مرة أخرى.');
            sendBtn.disabled = false;
        }
    }
    
    function acceptAIText() {
        if (currentTextarea && suggestedText) {
            currentTextarea.value = suggestedText;
            currentTextarea.dispatchEvent(new Event('input', { bubbles: true }));
            currentTextarea.dispatchEvent(new Event('change', { bubbles: true }));
            addAIMessage('system', '✓ تم تطبيق التغييرات بنجاح!');
            suggestedText = '';
        }
    }
    
    function declineAIText() {
        addAIMessage('system', 'تم رفض التغييرات. يمكنك طلب تعديل آخر.');
        suggestedText = '';
    }
    
    function watchForTextarea() {
        const observer = new MutationObserver(() => {
            injectAIButton();
        });
        
        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
        
        injectAIButton();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            createMenu();
            watchForTextarea();
        });
    } else {
        createMenu();
        watchForTextarea();
    }
})();
